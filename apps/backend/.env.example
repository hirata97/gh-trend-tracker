# GitHub Personal Access Token
# データ収集スクリプト用（未実装）
GITHUB_TOKEN=your_github_personal_access_token

# 実行環境（production を設定すると本番モードになる）
# 本番環境では必ず production を設定すること
ENVIRONMENT=development

# 許可するCORSオリジン（カンマ区切りで複数指定可）
# 本番環境では必ず設定すること（未設定の場合、全オリジンが拒否される）
# 例: https://example.com,https://app.example.com
ALLOWED_ORIGINS=

# Cloudflare Turnstile（Phase 3: Bot対策）
# Cloudflare ダッシュボード > Turnstile でサイトキーとシークレットキーを発行
# テストモード用キー:
#   シークレットキー: 1x0000000000000000000000000000000AA（常に成功）
#   シークレットキー: 2x0000000000000000000000000000000AA（常に失敗）
# https://developers.cloudflare.com/turnstile/reference/testing/
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
