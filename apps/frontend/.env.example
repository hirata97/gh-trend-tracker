# API Base URL
# For local development
PUBLIC_API_URL=http://localhost:8787

# For production (replace with your Cloudflare Workers URL)
# PUBLIC_API_URL=https://gh-trend-tracker-api.YOUR_ACCOUNT.workers.dev

# Sentry DSN（エラー収集）
# Sentry プロジェクト設定画面から取得
# https://sentry.io/settings/[org]/projects/[project]/keys/
PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile サイトキー（Phase 3: Bot対策）
# Cloudflare ダッシュボード > Turnstile でサイトキーを発行
# テストモード用サイトキー:
#   1x00000000000000000000AA（常に成功）
#   2x00000000000000000000AB（常に失敗）
#   3x00000000000000000000FF（インタラクションを要求）
# https://developers.cloudflare.com/turnstile/reference/testing/
PUBLIC_TURNSTILE_SITE_KEY=
