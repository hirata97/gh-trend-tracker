# API Base URL
# For local development
PUBLIC_API_URL=http://localhost:8787

# For production (replace with your Cloudflare Workers URL)
# PUBLIC_API_URL=https://gh-trend-tracker-api.YOUR_ACCOUNT.workers.dev

# Sentry DSN（エラー収集）
# Sentry プロジェクト設定画面から取得
# https://sentry.io/settings/[org]/projects/[project]/keys/
PUBLIC_SENTRY_DSN=
