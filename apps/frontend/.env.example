# API Base URL
# 環境ごとに切り替えて使用する。CI/CDでは自動設定される。
#
# ローカル開発: localhost（デフォルト値のため設定省略可）
PUBLIC_API_URL=http://localhost:8787

# PR Preview環境（CIがDEV_API_URLシークレットから自動設定）
# PUBLIC_API_URL=https://gh-trend-tracker-api.<account>.workers.dev

# 本番環境（CIがPROD_API_URLシークレットから自動設定）
# PUBLIC_API_URL=https://gh-trend-tracker-api.<account>.workers.dev

# Sentry DSN（エラー収集）
# Sentry プロジェクト設定画面から取得
# https://sentry.io/settings/[org]/projects/[project]/keys/
PUBLIC_SENTRY_DSN=
